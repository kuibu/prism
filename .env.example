# Gateway API
GATEWAY_ENV=development
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
HTTP_TIMEOUT_SECONDS=3.0
HTTP_RETRY_ATTEMPTS=3
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_DEFAULT_TIMEOUT_SECONDS=0
TELEGRAM_POLL_DEFAULT_LIMIT=20
TELEGRAM_OUTBOUND_DEFAULT_LIMIT=3
AGENT_DEFAULT_LLM_ENABLED=true
AGENT_DEFAULT_LLM_PROVIDER=openai_compatible
AGENT_DEFAULT_LLM_MODEL=qwen2.5-32b
AGENT_DEFAULT_LLM_API_KEY=
AGENT_DEFAULT_LLM_BASE_URL=https://32b.qwen.rag8.cn/v1
AGENT_DEFAULT_LLM_API_PATH=/chat/completions
AGENT_DEFAULT_LLM_TEMPERATURE=0.3
AGENT_DEFAULT_LLM_MAX_TOKENS=500
AGENT_DEFAULT_LLM_TIMEOUT_SECONDS=18.0
AGENT_MEMORY_BACKEND=local
OPENVIKING_BASE_URL=http://openviking:1933
OPENVIKING_API_KEY=
OPENVIKING_AGENT_ID=prism-gateway-api
OPENVIKING_TIMEOUT_SECONDS=6.0
OPENVIKING_RETRY_ATTEMPTS=2

# OPA
OPA_URL=http://opa:8181
OPA_POLICY_PATH=/v1/data/prism/allow
OPA_DATA_ROOT=/v1/data/prism

# immudb
IMMUDB_HOST=immudb
IMMUDB_PORT=3322
IMMUDB_TIMEOUT_SECONDS=2.0
IMMUDB_RETRY_ATTEMPTS=3
IMMUDB_USERNAME=immudb
IMMUDB_PASSWORD=immudb
IMMUDB_DATABASE=defaultdb

# Matrix
MATRIX_HOMESERVER_URL=http://synapse:8008
MATRIX_UPLOAD_MAX_BYTES=10485760
MATRIX_AGENT_BOT_USERNAME_PREFIX=prism_agent
MATRIX_AGENT_BOT_PASSWORD_SECRET=dev_agent_bot_secret
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_REPORT_STATS=no
SYNAPSE_REGISTRATION_SHARED_SECRET=dev_shared_secret

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101

# immudb host port mapping (container still listens on 3322 internally)
IMMUDB_HOST_PORT=3332
IMMUDB_ADMIN_HOST_PORT=9497
